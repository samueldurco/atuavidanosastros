# Safety and feature flags
AUTOMATIC_SPEND_CAP_BRL=0
FEATURE_AI=false
FEATURE_HOTMART_LIVE=false
FEATURE_ATV_PLUS_COMMERCIAL=false
FEATURE_MAGIC_LINK=false
FEATURE_PHYSICAL_CHECKOUT=false
# P06: independent receiver, responder and public entry gates. Keep off until homologated.
FEATURE_WHATSAPP_WEBHOOK=false
FEATURE_WHATSAPP_CONSULTATION=false
FEATURE_WHATSAPP_PUBLIC_ENTRY=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_COMMERCIAL_NUMBER=
WHATSAPP_CONSULTATION_SUBJECT_SECRET=
# ISO timestamp after verifying the dedicated sender, callback and free reply; expires in 7 days.
WHATSAPP_CONSULTATION_VERIFIED_AT=
# Proof that WhatsApp transport replies cost R$ 0 inside the service window.
# This is not a free product gate: P06 offers paid digital products only.
WHATSAPP_CONSULTATION_FREE_REPLY_VERIFIED=false
SHOP_SELLER_DISCLOSURE_APPROVED=false
# Set only after validating the total delivery time for every enabled shipping zone.
SHOP_DELIVERY_MAX_BUSINESS_DAYS=
# Confirm the Shopify checkout charges one flat R$ 29.90 per order across every enabled
# destination and basket before setting 29.90 here. Other shipping rules require a code change.
SHOP_VERIFIED_FLAT_SHIPPING_BRL=
# Explicitly approved public seller identity. Configure actual values at runtime;
# never commit personal identity, addresses or tax identifiers.
SHOP_SELLER_PUBLIC_NAME=
SHOP_SELLER_PUBLIC_ADDRESS=
# Optional when the official storefront address already includes its commercial CEP.
SHOP_SELLER_PUBLIC_POSTCODE=
SHOP_SELLER_PUBLIC_EMAIL=
# Populate only after the actual document and its public disclosure are verified.
SHOP_SELLER_PUBLIC_DOCUMENT=
# Private exclusion for storefront disclosures. Set a JSON object with street and number as a secret.
SHOP_SELLER_PRIVATE_RETURN_LOCATION=
ADMIN_EMAIL_ALLOWLIST=
