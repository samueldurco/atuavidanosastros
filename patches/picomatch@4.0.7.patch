 const analyzeRepeatedExtglob = (body, options) => {
+  // ATVNA: fail closed for single-branch wildcard repetition until upstream
+  // fixes GHSA-fc5q-39xc-vjpf. The existing risky path treats it as literal
+  // text, avoiding nested unbounded quantifiers. Do not allow the recursion
+  // opt-out to disable this security boundary.
+  const singleBranch = splitTopLevel(body);
+  if (singleBranch.length === 1 && singleBranch[0].includes('*')) {
+    return { risky: true };
+  }
