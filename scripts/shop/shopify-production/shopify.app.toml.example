# Replace this placeholder with the public client ID from the new, store-owned app.
client_id = "REPLACE_WITH_DEDICATED_APP_CLIENT_ID"
name = "ATVNA Produção Dimona"
application_url = "https://atuavidanosastros.com.br/loja"
embedded = false

[access_scopes]
scopes = "read_orders,read_products,write_merchant_managed_fulfillment_orders"

[auth]
redirect_urls = []

[build]
automatically_update_urls_on_dev = false

# Register this store's ORDERS_PAID once with ../production-webhook.mjs.
[webhooks]
api_version = "2026-10"
