{
  "name": "a-tua-vida-nos-astros",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo da plataforma A Tua Vida nos Astros.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @atv/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:db": "node --test scripts/product-runs-db.test.mjs",
    "test:e2e": "pnpm --filter @atv/web test:e2e",
    "format": "pnpm --filter @atv/web format",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "supabase": "^2.56.1",
    "typescript": "^6.0.3"
  }
}
